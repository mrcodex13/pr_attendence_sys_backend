NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://24ir10ka34_db_user:pgDxfVGRlT0AQilt@cluster0.cgwsq00.mongodb.net/
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Set a stable independent secret in production; otherwise it is derived from ACCESS_TOKEN_SECRET.
DEVICE_SECRET_ENCRYPTION_KEY=
# Required in production and to enable webcam face-template enrollment.
# Keep it stable and private; losing it makes existing templates unreadable.
FACE_TEMPLATE_ENCRYPTION_KEY=
# Optional: private AMB82 Mini RTSP URL (kept on the backend; never use a VITE_ variable).
AMB82_RTSP_URL=
# Optional: ffmpeg executable path if it is not available on PATH.
FFMPEG_PATH=ffmpeg
SUPABASE_URL=
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:5173
# Optional: return a one-time reset link only to loopback callers in development.
DEV_PASSWORD_RESET_ENABLED=false

# Required in production to deliver password-reset emails. SMTP is intentionally
# optional in local development until an email provider is selected.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
