# Runtime mode; keep local development separate from production.
NODE_ENV=development
# HTTP port; Render provides its own PORT value at runtime.
PORT=8000
# MongoDB connection string for local development.
MONGODB_URI=mongodb://localhost:27017/attendance
# Comma-separated browser origins permitted to call the API.
ALLOWED_ORIGINS=http://localhost:5173
# Private signing secret; use a unique random value in production.
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Lifetime of an access token, using s, m, h, or d units.
ACCESS_TOKEN_TTL=15m
# Number of days before refresh tokens expire.
REFRESH_TOKEN_DAYS=30
# Private key for encrypting device secrets; keep stable in production.
DEVICE_SECRET_ENCRYPTION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
# Private stable key for encrypting face templates in production.
FACE_TEMPLATE_ENCRYPTION_KEY=replace-with-another-random-secret-of-at-least-32-characters
# Optional private AMB82 RTSP stream URL; never expose it with a VITE_ variable.
AMB82_RTSP_URL=
# Deprecated RTSP setting; use AMB82_RTSP_URL instead.
RTSP_URI=
# Optional FFmpeg executable path; Render's standard Node runtime has no FFmpeg.
FFMPEG_PATH=ffmpeg
# Supabase project origin for encrypted face-template storage.
SUPABASE_URL=https://example.supabase.co
# Private Supabase secret key; backend only and required in production.
SUPABASE_SECRET_KEY=replace-with-your-private-supabase-secret
# Public frontend URL used in links and browser redirects.
APP_URL=http://localhost:5173
# Allow one-time password-reset links only for loopback callers in development.
DEV_PASSWORD_RESET_ENABLED=false

# SMTP host for delivering password-reset emails in production.
SMTP_HOST=
# SMTP server port, commonly 587 or 465.
SMTP_PORT=587
# Set true when SMTP requires implicit TLS.
SMTP_SECURE=false
# SMTP account name for password-reset delivery.
SMTP_USER=
# Private SMTP account password.
SMTP_PASSWORD=
# Sender address used for outgoing email.
MAIL_FROM=
# Organization name used only by the one-time admin seed command.
SEED_ORG_NAME=
# URL-safe organization identifier used only by the seed command.
SEED_ORG_SLUG=
# Admin display name used only by the one-time seed command.
SEED_ADMIN_NAME=
# Admin email used only by the one-time seed command.
SEED_ADMIN_EMAIL=
# Unique strong admin password used only by the one-time seed command.
SEED_ADMIN_PASSWORD=
